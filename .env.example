# Required only when using the OpenAI translator provider.
OPENAI_API_KEY=

# Optional. The default model is configured in the CLI.
OPENAI_TRANSLATE_MODEL=gpt-4.1-mini

# Required only when using the DeepSeek translator provider.
DEEPSEEK_API_KEY=

# Optional DeepSeek settings.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TRANSLATE_MODEL=deepseek-v4-flash
